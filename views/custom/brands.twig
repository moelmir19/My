<section id="block{{ content['block_id'] }}" class="ui-brands site-container">
    {% if content['setting']['brands_title'] %}
        <div class="ui-section-heading">
            <h2>{{ content['setting']['brands_title'] }}</h2>
        </div>
    {% endif %}

    <div id="slider{{ content['block_id'] }}" class="ui-brands__slider owl-carousel">
        {% for brand in content['settings']['brands'] %}
            <a href="" class="ui-brand-card" aria-label="{{ brand['name'] }}">
                <div class="ui-brand-card__logo">
                    <img src="{{ storage_url ~ brand['logo'] }}" alt="{{ brand['name'] }}" loading="lazy" />
                </div>
                <h3>{{ brand['name'] }}</h3>
            </a>
        {% endfor %}
    </div>
</section>
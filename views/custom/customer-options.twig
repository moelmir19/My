<section id="block{{ content['block_id'] }}" class="ui-testimonials site-container">
    {% if content['setting']['customer_options'] %}
        <div class="ui-section-heading ui-section-heading--row">
            <h2>{{ content['setting']['customer_options'] }}</h2>
            <div class="ui-slider-controls">
                <button type="button" class="product-group-arrow-prev" aria-label="Previous"><i class="icon-caret-{{ lang == 'ar' ? 'right':'left' }}"></i></button>
                <button type="button" class="product-group-arrow-next" aria-label="Next"><i class="icon-caret-{{ lang == 'ar' ? 'left':'right' }}"></i></button>
            </div>
        </div>
    {% endif %}

    <div id="slider{{ content['block_id'] }}" class="ui-testimonials__slider owl-carousel">
        {% for review in content['settings']['reviews'] %}
            <article class="ui-testimonial-card">
                <div class="ui-testimonial-card__head">
                    <img
                        src="{{ asset_url ~ ('images/') }}{{ review['customer']['gender'] ?? 'other' }}-gender.png"
                        alt="{{ review['name'] }}"
                        loading="lazy">
                    <div>
                        {% if content['settings']['hide_user'] != 'true' %}
                            <h4>{{ review['name'] }}</h4>
                        {% endif %}
                        <div class="ui-rating" aria-label="{{ review['rating'] }}/5">
                            {% for i in 0..4 %}
                                <i class="icon-star2 {{ review['rating'] > i ? 'is-active' : '' }}"></i>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <p>{{ review['comment'] }}</p>
                <i class="testimonial__icon icon-quote ui-testimonial-card__quote"></i>
            </article>
        {% endfor %}
    </div>
</section>
<section class="ui-features site-container">
    <div class="ui-features__grid">
        {% for item in content['settings']['items'] %}
            <article class="ui-feature-card">
                <div class="ui-feature-card__icon"><i class="{{ item['icon'] }}"></i></div>
                <div class="ui-feature-card__content">
                    <h2>{{ item['main_title'] }}</h2>
                    <p>{{ item['sub_title'] }}</p>
                </div>
            </article>
        {% endfor %}
    </div>
</section>
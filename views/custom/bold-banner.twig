{% if content['settings']['image'] %}
    <div id="block{{ content['block_id'] }}" class="qs-primary-banner">
        {% if content['settings']['link'] %}
            <a href="{{ content['settings']['link'] }}" class="qs-primary-banner__link">
        {% endif %}

        {% set show_banner = true %}

        {% if content['settings']['start_date'] and content['settings']['start_date'] != '' %}
            {% if "now"|date < content['settings']['start_date'] %}
                {% set show_banner = false %}
            {% endif %}
        {% endif %}

        {% if content['settings']['end_date'] and content['settings']['end_date'] != '' %}
            {% if "now"|date > content['settings']['end_date'] %}
                {% set show_banner = false %}
            {% endif %}
        {% endif %}

        {% if show_banner %}
            <img
                class="qs-primary-banner__image"
                src="{{ content['settings']['image'] }}"
                alt="Banner"
                loading="eager"
                decoding="async">
        {% endif %}

        {% if content['settings']['link'] %}
            </a>
        {% endif %}
    </div>
{% endif %}
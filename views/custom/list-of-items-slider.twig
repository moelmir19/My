<section class="ui-banner-slider site-container">
    <div class="swiper myListSwiper">
        <div class="swiper-wrapper">
            {% for item in content['settings']['items'] %}
                <div class="swiper-slide">
                    <article class="ui-banner-card ui-banner-card--wide {{ item['name'] ? 'ui-banner-card--overlay' : '' }}">
                        <div class="ui-banner-card__image" style="background-image: url('{{ item['image'] }}');"></div>
                        <a href="{{ item['link'] ?? '' }}" class="ui-banner-card__link" aria-label="{{ item['name']|default('link') }}">
                            {% if item['name'] %}<h3>{{ item['name'] }}</h3>{% endif %}
                        </a>
                    </article>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
    </div>
</section>
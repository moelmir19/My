<section class="ui-banner-grid site-container">
    <div class="ui-banner-grid__items ui-banner-grid__items--{{ content['settings']['items']|length }}">
        {% for item in content['settings']['items'] %}
            <article class="ui-banner-card {{ item['name'] ? 'ui-banner-card--overlay' : '' }}">
                <div class="ui-banner-card__image" style="background-image: url('{{ item['image'] }}');"></div>
                {% if item['link'] %}
                    <a href="{{ item['link'] }}" class="ui-banner-card__link" aria-label="{{ item['name']|default('link') }}">
                {% endif %}
                {% if item['name'] %}
                    <h3>{{ item['name'] }}</h3>
                {% endif %}
                {% if item['link'] %}
                    </a>
                {% endif %}
            </article>
        {% endfor %}
    </div>
</section>
{# views/home/products-slider.twig #}
<section id="block{{ id }}" data-block-id="{{ id }}" class="ui-product-section">
    
    {# 1. Section Header (Re-rendered from the title/desc passed in AJAX) #}
    {% if title %}        
        <div class="section_title ui-section-heading">
            <h3 class="display-4 text-black bg-transparent">{{ title }}</h3>
            {% if description %}
                <p class="section-description">{{ description }}</p>
            {% elseif content['settings']['producrs_description'] %}
                <p class="section-description">{{ content['settings']['producrs_description'] }}</p>
            {% endif %}
        </div>
    {% endif %}

    {# 2. Owl Carousel Wrapper #}
    <div id="slider{{ id }}" class="home-grid mb-20 owl-carousel owl-theme">
        {% for product in products %}
            {# px-0 is important for sliders to prevent double-spacing #}
            <div class="product-box qs-product-card">
                <div class="product-card">
                    
                    {# New Badge #}
                    {% if product.new %}
                        <div class="sticker new">
                            {{ ('app.products.new'|trans) }}
                        </div>
                    {% endif %}

                    {# Product Image and Link #}
                    <a href="/{{ product.url_key }}" title="{{ product.name }}" class="product-a qs-product-card__link">
                        <div class="product-image qs-product-card__image">
                            <img src="{{ product.product.base_image_url }}" alt="{{ product.name }}" loading="lazy"/>
                            {% if product.promotion_title %}
                                <div class="card-promo">{{ product.promotion_title }}</div>
                            {% endif %}
                        </div>
                        
                        <div class="product-information qs-product-card__content">
                            <div class="product-name">
                                <p class="text-center">{{ product.name }}</p>
                            </div>
                        </div>
                    </a>

                    {# Price Logic #}
                    <div class="product-bottom-row qs-product-card__bottom">
                        <div class="qs-product-card__price">{{ product.html_price | raw }}</div>
                        <div class="qs-product-card__buttons">
                            <form action="/customer/wishlist/add/{{ product.product_id }}" method="GET">
                                <input type="hidden" name="product_id" value="{{ product.product_id }}">
                                <button type="submit" class="qs-wish-btn" title="إضافة منتج إلى قائمة الأمنيات"><i class="icon-heart"></i></button>
                            </form>
                            <form id="addToCart-{{ product.product_id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="product_id" value="{{ product.product_id }}">
                                <input type="hidden" name="quantity" value="1">
                                {% set outOfStock = getConfig('config.products.out-of-stock') == '1' %}
                                {% if outOfStock and not product.saleable %}
                                    <span class="not-available">{{ ('app.products.out_of_stock'|trans) }}</span>
                                {% else %}
                                    <button type="button" class="btn addToCart qs-order-btn" {{ product.saleable ? '' : 'disabled' }} data-id="{{ product.product_id }}"><i class="icon-cart"></i><span>{{ lang == 'ar' ? 'اطلب الآن' : 'Order now' }}</span></button>
                                {% endif %}
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
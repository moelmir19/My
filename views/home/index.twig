{% extends "layout/main.twig" %}

{% block title %} main {% endblock %}

{% block main_content %}
<div class="home home-categories-only">

    {# Primary banner only #}
    {% set primary_banner_rendered = false %}
    {% for content in homeContent %}
        {% if not primary_banner_rendered
            and ('fixed_banner' == content['slug'] or 'wide_banner' == content['slug'])
            and content['settings']['image'] %}
            <div class="home-primary-banner">
                {% include 'custom/bold-banner.twig' with {'content': content} %}
            </div>
            {% set primary_banner_rendered = true %}
        {% endif %}
    {% endfor %}

    {# Categories only — products are intentionally excluded from homepage #}
    {% set categories = getFunction('getHomepageCategories') %}
    {% include 'home/categories-grid.twig' with {'categories': categories} %}

</div>
{% endblock %}

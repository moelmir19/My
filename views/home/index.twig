{% extends "layout/main.twig" %}

{% block title %} main {% endblock %}

{% block main_content %}
<div class="home home-categories-only">

    {# SubCove visual identity stays fixed; platform data is used inside the category/product flows. #}
    <div class="home-primary-banner">
        <div class="qs-primary-banner">
            <img
                class="qs-primary-banner__image"
                src="{{ asset_url ~ 'images/subcove-banner.png' }}"
                alt="{{ lang == 'ar' ? 'بنر SubCove' : 'SubCove banner' }}"
                loading="eager"
                decoding="async">
        </div>
    </div>

    {# Same SubCove category-card UI, backed by Twsaa's official /category endpoint. #}
    {% include 'home/categories-grid.twig' %}

    {# Keep the custom SubCove FAQ/reviews section. #}
    {% include 'home/faq-reviews.twig' %}

</div>
{% endblock %}

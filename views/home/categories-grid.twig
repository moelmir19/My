{#
  SubCove visual markup, powered by Twsaa's existing category data.
  getCategories() is a function from the upstream Twig extension and provides
  an inert fallback if the upstream /category request fails.
#}
{% set platform_categories = getFunction('getCategories') %}
<section class="home-categories home-demo-services" id="qs-home-categories">
    <div class="home-categories__heading">
        <h2>{{ lang == 'ar' ? 'الأقسام' : 'Categories' }}</h2>
    </div>

    <div class="home-demo-services__grid"
         id="qs-platform-category-grid"
         aria-live="polite"
         aria-busy="true"></div>

    {# Keep the upstream function's HTML inert; external JS parses its links if needed. #}
    <template id="qs-platform-category-fallback">{{ platform_categories['html']|default('')|raw }}</template>
</section>
<script defer src="{{ asset_url ~ 'js/subcove-categories.js' }}"></script>

{% set items = content['settings']['items']|default([]) %}
{% set section_title = content['settings']['title']|default('') %}

{% if items|length > 0 %}
<section class="home-categories home-demo-services">
    <div class="home-categories__heading">
        <h2>{{ section_title ?: (lang == 'ar' ? 'الاشتراكات' : 'Subscriptions') }}</h2>
    </div>

    <div class="home-demo-services__grid">
        {% for item in items %}
            {% set item_name = item['name']|default('') %}
            {% set item_image = item['image']|default('') %}
            {% set item_link = item['link']|default('') %}

            {% if item_name or item_image or item_link %}
                <a class="home-service-link-card" href="{{ item_link ?: '#' }}">
                    <div class="home-service-link-card__media">
                        {% if item_image %}
                            <img
                                src="{{ item_image }}"
                                alt="{{ item_name }}"
                                class="home-service-link-card__image"
                                loading="lazy"
                                decoding="async">
                        {% endif %}
                    </div>

                    <div class="home-service-link-card__content">
                        {% if item_name %}
                            <strong>{{ item_name }}</strong>
                        {% endif %}
                        <span>{{ lang == 'ar' ? 'عرض الاشتراكات' : 'View subscriptions' }}</span>
                    </div>

                    <span class="home-service-link-card__arrow" aria-hidden="true">←</span>
                </a>
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}

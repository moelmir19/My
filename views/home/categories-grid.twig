{% set demo_services = [
    {
        'name': 'Netflix',
        'slug': 'netflix',
        'image': '/assets/images/subcove-netflix.png'
    },
    {
        'name': 'YouTube',
        'slug': 'youtube',
        'image': '/assets/images/subcove-youtube.png'
    },
    {
        'name': 'OSN',
        'slug': 'osn',
        'image': '/assets/images/subcove-osn.png'
    }
] %}

<section class="home-categories home-demo-services">
    <div class="home-categories__heading">
        <h2>الاشتراكات</h2>
    </div>

    <div class="home-demo-services__grid">
        {% for service in demo_services %}
            <a class="home-service-link-card" href="/subscriptions/{{ service.slug }}">
                <div class="home-service-link-card__media">
                    <img
                        src="{{ service.image }}"
                        alt="{{ service.name }}"
                        class="home-service-link-card__image"
                        loading="lazy"
                        decoding="async">
                </div>

                <div class="home-service-link-card__content">
                    <strong>{{ service.name }}</strong>
                    <span>عرض الاشتراكات</span>
                </div>

                <span class="home-service-link-card__arrow" aria-hidden="true">←</span>
            </a>
        {% endfor %}
    </div>
</section>
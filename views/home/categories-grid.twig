{#
  SubCove keeps only the presentation.
  Category data is sourced from Twsaa's official getCategories() function.
  The returned HTML stays escaped in a hidden data attribute; our JS converts
  top-level platform categories into the existing SubCove card markup.
#}
{% set platform_categories = getFunction('getCategories') %}
{% set platform_categories_html = platform_categories['html']|default('') %}

<section class="home-categories home-demo-services" id="qs-home-categories">
    <div class="home-categories__heading">
        <h2>{{ lang == 'ar' ? 'الأقسام' : 'Categories' }}</h2>
    </div>

    <div
        class="home-demo-services__grid"
        id="qs-platform-category-grid"
        aria-live="polite"
        aria-busy="true"></div>

    {# Keep the platform fragment as an escaped data attribute, never live DOM nodes.
       A raw <template> can be unwrapped by client-side template compilers,
       exposing the original category <li> links below SubCove's cards. #}
    <div id="qs-platform-category-fallback" hidden aria-hidden="true"
         data-category-html="{{ platform_categories_html|e('html_attr') }}"></div>
</section>

<script src="{{ asset_url ~ 'js/subcove-categories.js' }}"></script>

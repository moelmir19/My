{% set faq_items = faq_content ? faq_content['settings']['items']|default([]) : [] %}
{% set review_items = reviews_content ? reviews_content['settings']['reviews']|default([]) : [] %}
{% set hide_review_user = reviews_content ? reviews_content['settings']['hide_user']|default('') : '' %}

{% set rating_total = 0 %}
{% for review in review_items %}
    {% set rating_total = rating_total + review['rating']|default(0) %}
{% endfor %}
{% set rating_count = review_items|length %}
{% set rating_average = rating_count > 0 ? (rating_total / rating_count) : 0 %}

{% if faq_items|length > 0 or review_items|length > 0 %}
<section class="qs-faq-reviews">
    <div class="qs-container">
        {% if faq_items|length > 0 %}
            <div class="qs-faq-wrap">
                <div class="qs-section-heading">
                    <h2>{{ lang == 'ar' ? 'الأسئلة الشائعة' : 'Frequently asked questions' }}</h2>
                    <p>{{ lang == 'ar' ? 'كل ما تحتاج معرفته قبل الطلب' : 'Everything you need to know before ordering' }}</p>
                </div>

                <div class="qs-faq-list">
                    {% for item in faq_items %}
                        {% set question = item['main_title']|default('') %}
                        {% set answer = item['sub_title']|default('') %}

                        {% if question or answer %}
                            <details class="qs-faq-item">
                                <summary class="qs-faq-q">
                                    <span class="qs-faq-q-text">{{ question }}</span>
                                    <span class="qs-faq-icon" aria-hidden="true">+</span>
                                </summary>

                                <div class="qs-faq-panel">
                                    <div class="qs-faq-panel-inner">
                                        <p class="qs-faq-answer">{{ answer }}</p>
                                    </div>
                                </div>
                            </details>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if review_items|length > 0 %}
            <div class="qs-reviews-wrap">
                <div class="qs-section-heading qs-reviews-heading">
                    <h2>{{ lang == 'ar' ? 'آراء عملائنا' : 'Customer reviews' }}</h2>

                    <div class="qs-reviews-summary">
                        <div class="qs-review-stars" dir="ltr" aria-label="{{ rating_average|number_format(1) }} / 5">
                            {% for i in 1..5 %}
                                <span class="{{ i <= rating_average|round ? 'is-active' : '' }}">★</span>
                            {% endfor %}
                        </div>
                        <div class="qs-reviews-score">
                            <strong>{{ rating_average|number_format(1) }}</strong>
                            <span>{{ lang == 'ar' ? 'من 5' : 'of 5' }}</span>
                        </div>
                        <i class="qs-reviews-separator"></i>
                        <span class="qs-reviews-count">
                            {{ lang == 'ar'
                                ? 'بناءً على ' ~ rating_count ~ ' تقييم'
                                : 'Based on ' ~ rating_count ~ ' reviews' }}
                        </span>
                    </div>
                </div>

                <div class="qs-reviews-grid">
                    {% for review in review_items %}
                        {% set review_name = hide_review_user == 'true'
                            ? (lang == 'ar' ? 'عميل' : 'Customer')
                            : review['name']|default(lang == 'ar' ? 'عميل' : 'Customer') %}
                        {% set review_rating = review['rating']|default(0) %}
                        {% set review_text = review['comment']|default('') %}
                        {% set review_product = '' %}
                        {% if review['product'] is defined and review['product'] and review['product']['name'] is defined %}
                            {% set review_product = review['product']['name'] %}
                        {% elseif review['product_name'] is defined %}
                            {% set review_product = review['product_name'] %}
                        {% endif %}

                        <article class="qs-review-card">
                            <span class="qs-review-quote" aria-hidden="true">“</span>

                            <div class="qs-review-stars qs-review-card-stars" dir="ltr" aria-label="{{ review_rating }} / 5">
                                {% for i in 1..5 %}
                                    <span class="{{ i <= review_rating ? 'is-active' : '' }}">★</span>
                                {% endfor %}
                            </div>

                            <p class="qs-review-text">{{ review_text }}</p>

                            <div class="qs-review-footer">
                                <span class="qs-review-avatar">{{ review_name|slice(0, 1) }}</span>

                                <div class="qs-review-person">
                                    <strong>{{ review_name }}</strong>
                                    {% if review_product %}
                                        <span class="qs-review-product">
                                            <i class="icon-packed-box" aria-hidden="true"></i>
                                            {{ review_product }}
                                        </span>
                                    {% endif %}
                                </div>

                                {% if review['created_at'] is defined and review['created_at'] %}
                                    <time class="qs-review-date">{{ review['created_at']|date('d M Y') }}</time>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endif %}

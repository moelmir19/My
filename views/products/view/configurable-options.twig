
<div class="product-options" id="product-options">
    <div class="attributes">
        <input type="hidden" id="selected_configurable_option" name="selected_configurable_option" value="">
        {% for index, attribute in childAttributes['attributes'] %}
            <div class="attribute control-group" data-attribute-id="{{ attribute['id'] }}">
                <label class="required">{{ attribute['label'] }}</label>
                 {% if (not attribute['swatch_type'] or attribute['swatch_type'] == '' or attribute['swatch_type'] == 'dropdown') and attribute['code'] != 'image' and attribute['code'] != 'color' %}
                    <select class="control" name="super_attribute[{{ attribute['id'] }}]" data-attribute-id="{{ attribute['id'] }}" 
                    required
                    @change="configure({{ attribute['id'] }}, $event.target.value, {{ index }})"
                    >
                        <option value="">{{ ('shop::app.products.select-above-options'|trans) }}</option>
                        {% for option in attribute['options'] %}
                            <option value="{{ option['id'] }}">{{ option['label'] }}</option>
                        {% endfor %}
                    </select>
                {% else %}
                    <div class="swatch-container">
                        {% for option in attribute['options'] %}
                            <label class="swatch" data-id="{{ option['id'] }}">
                                <input type="radio" name="super_attribute[{{ attribute['id'] }}]" value="{{ option['id'] }}" required @change="configure({{ attribute['id'] }}, {{ option['id'] }}, {{ index }})" />
                                {% if attribute['code'] == 'color' %}
                                    <span style="background: {{ option['swatch_value'] }};"></span>
                                {% elseif attribute['code'] == 'image' %}
                                    <img src="{{ option['swatch_url'] }}" alt="{{ option['label'] }}">
                                {% else %}
                                    {{ option['label'] }}
                                {% endif %}
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
                <span class="control-error" data-error-for="super_attribute[{{ attribute['id'] }}]"></span>
            </div>
        {% endfor %}
    </div>
</div>

<script>


    // Variant IDs, formatted prices and stock are supplied by Twsaa in childAttributes.
    // Do not calculate a subscription-plan price or keep the previous variant selected.
    var allowedProducts = [];
    var simpleProduct = '';
    var config = {{ childAttributes | json_encode | raw }};
    var initialPriceMarkup = $('.product-price').html();

    function findCommonValues(arrays) {
        if (!arrays.length) return [];
        return arrays.reduce(function (common, products) {
            return common.filter(function (id) { return products.includes(id); });
        });
    }

    function configure(attribute, option, index) {
        var matchedAttribute = (config.attributes || []).find(function (item) {
            return String(item.id) === String(attribute);
        });
        var matchedOption = matchedAttribute && (matchedAttribute.options || []).find(function (item) {
            return String(item.id) === String(option);
        });

        // An emptied dropdown or an unavailable combination must clear old state.
        allowedProducts[index] = matchedOption && Array.isArray(matchedOption.products)
            ? matchedOption.products : [];
        var selected = allowedProducts.filter(function (products) {
            return Array.isArray(products) && products.length > 0;
        });
        var possible = selected.length === (config.attributes || []).length
            ? findCommonValues(selected) : [];
        var candidate = possible.length ? possible[0] : '';
        var variant = candidate !== '' && config.variant_prices
            ? config.variant_prices[candidate] : null;

        simpleProduct = variant ? candidate : '';
        $('#selected_configurable_option').val(simpleProduct);
        reloadPrice(variant);
        changeStock(variant);
    }

    function reloadPrice(variant) {
        var priceElement = $('.product-price');
        if (!variant || !variant.final_price || !variant.final_price.formated_price) {
            // Original platform price is a range until a valid variant is chosen.
            priceElement.html(initialPriceMarkup);
            window.MAX_QTY = null;
            return;
        }

        // The final_price field already reflects the platform's configured price.
        priceElement.html(variant.final_price.formated_price);
        $('.product-shipping-weight').text(variant.weight == null ? '' : variant.weight);
        var available = Math.max(0, Number(variant.qty) || 0);
        qty = available > 0 ? 1 : 0;
        minQuantity = available > 0 ? 1 : 0;
        maxQuantity = available;
        window.MAX_QTY = available;
        $('#qtyBox').attr({ min: minQuantity, max: maxQuantity }).val(qty);
    }

    function changeStock(variant) {
        var stock = document.querySelector('.stock-status');
        if (!stock) return;
        if (!variant) {
            stock.style.display = 'none';
            return;
        }
        var available = Number(variant.qty) > 0;
        stock.style.display = '';
        stock.classList.toggle('active', available);
        stock.textContent = available
            ? {{ ('shop::app.products.in-stock'|trans)|json_encode|raw }}
            : {{ ('shop::app.products.out-of-stock'|trans)|json_encode|raw }};
    }
</script>


<script>
    window.MAX_QTY = {{product.total_quantity}};
</script>


{% extends "layout/main.twig" %}

{% block title %}{{ service.name }}{% endblock %}

{% block main_content %}
<section class="subscription-product-page">
    <div class="qs-container subscription-product">
        <a href="/" class="subscription-product__back">← العودة للاشتراكات</a>

        <div class="subscription-product__layout">
            <div class="subscription-product__visual">
                <img src="{{ service.image }}" alt="{{ service.name }}">
            </div>

            <div class="subscription-product__content">
                <span class="subscription-product__eyebrow">اشتراك رقمي</span>
                <h1>{{ service.name }}</h1>
                <p class="subscription-product__description">{{ service.description }}</p>

                <form action="/subscription/add" method="POST" class="subscription-product__form">
                    <input type="hidden" name="service" value="{{ service.slug }}">

                    <div class="subscription-plan-heading">
                        <strong>اختر الباقة</strong>
                        <span>حدد المدة المناسبة لك</span>
                    </div>

                    <div class="subscription-plan-grid">
                        {% for plan in service.plans %}
                            <label class="subscription-plan-card">
                                <input
                                    type="radio"
                                    name="plan"
                                    value="{{ plan.key }}"
                                    data-price="{{ plan.price }}"
                                    {% if loop.first %}checked{% endif %}>
                                <span class="subscription-plan-card__body">
                                    <span class="subscription-plan-card__name">{{ plan.name }}</span>
                                    <strong>{{ plan.price }} SAR</strong>
                                    <span class="subscription-plan-card__hint">{{ plan.hint }}</span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>

                    <div class="subscription-product__purchase">
                        <div class="subscription-product__price">
                            <span>السعر</span>
                            <strong class="subscription-selected-price">
                                {% for plan in service.plans %}
                                    <span class="subscription-selected-price__value subscription-price-{{ plan.key }}">
                                        {{ plan.price }} SAR
                                    </span>
                                {% endfor %}
                            </strong>
                        </div>

                        <button type="submit" class="subscription-product__add">
                            إضافة للسلة
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {% if service.details_html %}
            <section class="qs-product-description-section" aria-labelledby="subscription-description-title">
                <div class="qs-product-description-section__header">
                    <span>تفاصيل المنتج</span>
                    <h2 id="subscription-description-title">الوصف</h2>
                </div>

                <div class="qs-product-description-section__body">
                    <div class="qs-product-description-richtext">
                        {{ service.details_html|raw }}
                    </div>
                </div>
            </section>
        {% endif %}
    </div>
</section>

<div class="qs-cart-toast" id="qs-cart-toast" role="status" aria-live="polite"></div>

<script>
(function () {
    var form = document.querySelector('.subscription-product__form');
    var radios = document.querySelectorAll('.subscription-plan-card input[type="radio"]');
    var toast = document.getElementById('qs-cart-toast');
    var button = form ? form.querySelector('.subscription-product__add') : null;
    var toastTimer = null;

    function showToast(message, isError) {
        if (!toast) return;

        toast.textContent = message;
        toast.classList.toggle('is-error', !!isError);
        toast.classList.add('is-visible');

        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
            toast.classList.remove('is-visible');
        }, 2800);
    }

    function updateCartCount(count) {
        document.querySelectorAll('.cart-count.count').forEach(function (el) {
            el.textContent = count;
        });
    }

    if (!form) return;

    form.addEventListener('submit', function (event) {
        event.preventDefault();

        if (button) {
            button.disabled = true;
            button.classList.add('is-loading');
        }

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            return response.json().then(function (data) {
                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'تعذر إضافة المنتج إلى السلة');
                }
                return data;
            });
        })
        .then(function (data) {
            updateCartCount(data.cart_count || 0);
            showToast(data.message || 'تم إضافة المنتج إلى السلة');
        })
        .catch(function (error) {
            showToast(error.message || 'تعذر إضافة المنتج إلى السلة', true);
        })
        .finally(function () {
            if (button) {
                button.disabled = false;
                button.classList.remove('is-loading');
            }
        });
    });
})();
</script>
{% endblock %}

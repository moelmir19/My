<header class="qs-header">
    {% set channel = getFunction('getCurrentChannel') %}

    <div class="qs-topbar">
        <div class="qs-container qs-topbar__inner">
            <div class="qs-topbar__side">
                <div class="qs-mini-dropdown">
                    <button type="button" class="qs-topbar__btn dropdown-toggle">
                        <i class="icon-world"></i>
                        <span>{{ lang|upper }}</span>
                    </button>
                    <div class="dropdown-list dropdown-links qs-dropdown" style="display:none;">
                        <ul>
                            {% for locale in getFunction('getAllLocales') %}
                                <li><a href="?locale={{ locale.code }}">{{ locale.name }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div class="qs-mini-dropdown">
                    <button type="button" class="qs-topbar__btn dropdown-toggle">
                        <i class="icon-flag"></i>
                        <span>{{ getFunction('getActiveChannelCurrency')[0].code|default('') }}</span>
                    </button>
                    <div class="dropdown-list dropdown-links qs-dropdown" style="display:none;">
                        <ul>
                            {% for currency in getFunction('getActiveChannelCurrency') %}
                                <li><a href="?currency={{ currency.code }}">{{ currency.code }} {{ currency.symbol }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="qs-topbar__message">
                {{ lang == 'ar' ? 'تسوق بسهولة واستلم طلبك بسرعة' : 'Shop easily with fast delivery' }}
            </div>

            <a class="qs-topbar__wallet" href="/customer/account/wallet">
                <i class="icon-bag-dollar"></i>
                <span>{{ getFunction('customerWallet') | default('0') | raw }}</span>
            </a>
        </div>
    </div>

    <div class="qs-main-header">
        <div class="qs-container qs-main-header__inner">
            <a href="/" class="qs-logo" aria-label="{{ channel.name|default('Quick Salla') }}">
                <img src="{{ asset_url ~ 'images/subcove-logo.png' }}" alt="{{ channel.name|default('Quick Salla') }}">
            </a>

            <div class="qs-search">
                <div class="ui search">
                    <input
                        class="prompt search-box qs-search__input"
                        type="text"
                        autocomplete="off"
                        placeholder="{{ lang == 'ar' ? 'يبحث ...' : 'Search ...' }}"
                        aria-label="{{ lang == 'ar' ? 'البحث' : 'Search' }}">
                    <i class="notch-loader gray search-loader" style="display:none;"></i>
                    <button type="button" class="qs-search__button" tabindex="-1" aria-label="{{ lang == 'ar' ? 'بحث' : 'Search' }}">
                        <svg class="qs-search__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M16.5 16.5L21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                    </button>
                    <div class="results"></div>
                </div>
            </div>

            <div class="qs-header-actions">
                <div class="qs-account-wrap">
                    <button
                        type="button"
                        class="qs-action {{ authUser ? 'dropdown-toggle' : '' }}"
                        {% if not authUser %}data-toggle="modal" data-target="#customerLoginModal"{% endif %}
                        aria-label="{{ lang == 'ar' ? 'الحساب' : 'Account' }}">
                        <i class="icon-user"></i>
                        <span>{{ authUser ? authUser.first_name : (lang == 'ar' ? 'الحساب' : 'Account') }}</span>
                    </button>

                    {% if authUser %}
                        <ul class="dropdown-list customer-dropdown dropdown-links qs-dropdown qs-account-menu">
                            <li class="no-link">{{ authUser.first_name }}</li>
                            <li><a href="/customer/account/notifications"><i class="icon-bell"></i>{{ ('shop::app.header.notifications'|trans) }}</a></li>
                            <li><a href="/customer/account/profile"><i class="icon-user"></i>{{ ('shop::app.header.profile'|trans) }}</a></li>
                            <li><a href="/customer/account/wishlist"><i class="icon-heart"></i>{{ ('shop::app.header.wishlist'|trans) }}</a></li>
                            <li><a href="/customer/account/orders"><i class="icon-packed-box"></i>{{ ('shop::app.header.orders'|trans) }}</a></li>
                            <li><a href="/customer/account/logout"><i class="icon-send-out"></i>{{ ('shop::app.header.logout'|trans) }}</a></li>
                        </ul>
                    {% endif %}
                </div>

                <a href="/checkout/cart" class="qs-action qs-cart">
                    <span class="qs-cart__icon">
                        <i class="icon-cart"></i>
                        <span class="cart-count count">{{ getFunction('cartItemsCount') }}</span>
                    </span>
                    <span>{{ lang == 'ar' ? 'السلة' : 'Cart' }}</span>
                </a>
            </div>
        </div>
    </div>

    {# Reuse the official /category menu without replacing the SubCove header. #}
    <nav class="qs-platform-nav" aria-label="{{ lang == 'ar' ? 'أقسام المتجر' : 'Store categories' }}">
        <div class="qs-container">
            {% include 'layout/navbar.twig' %}
        </div>
    </nav>
</header>
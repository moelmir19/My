{% set lang = getFunction('locale') %}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ lang == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">

    <title>{% block title %}{% endblock %}</title>
    {% set asset_url = getFunction('assets') %}
    {# {% set asset_url = '/twig-theme/assets/' %} #}
    {% set storage_url = 'https://cdn.twsaa.com/' %}

    {% if lang == 'ar' %}
        <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/bootstrap-ar.min.css' }}">
    {% else %}
        <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/bootstrap-en.min.css' }}">
    {% endif %}

    <link rel="stylesheet" type="text/css" href="https://tawasa4shujat.twsaa.com/themes/uray/assets/js/plugins/owlcarousel/assets/owl.carousel.min.css" />
    <link rel="stylesheet" type="text/css" href="https://tawasa4shujat.twsaa.com/themes/uray/assets/js/plugins/owlcarousel/assets/owl.theme.default.min.css" />
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/search.min.css' }}">
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/fonts.css' }}" />
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/front-fonts.css' }}" />
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/ui.css' }}">
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'js/plugins/owlcarousel/assets/owl.carousel.min.css' }}" />
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'js/plugins/owlcarousel/assets/owl.theme.default.min.css' }}" />
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/swiper-bundle.min.css' }}" />
    {% if lang == 'ar' %}
        <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/ar.css' }}" />
    {% else %}
        <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/en.css' }}" />
    {% endif %}
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/app.css' }}">
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/custom.css' }}">
    <link rel="stylesheet" type="text/css" href="{{ asset_url ~ 'css/ui-custom.css' }}">

    <link href="{{ asset_url ~ 'fonts/STC-Regular.ttf' }}">
    <link href="https://twsaa.com/admin-themes/mbotiq/assets/vendor/datepicker.min.css">
    <link href="https://twsaa.com/admin-themes/mbotiq/assets/vendor/bootstrap-select.min.css">
    <link href="https://twsaa.com/admin-themes/mbotiq/assets/vendor/toastr.min.css" rel="stylesheet">


    <style>
        :root {
            --brand: #6f8d7e;
            --brand-light: #f4f1e9;
        }

        .nav li { position: relative; }
        .nav .cat-sub { display: none; }
        .nav li:hover > .cat-sub { display: block; }
        .nav .cat-sub li:hover > .cat-sub {
            display: block;
            top: 0 !important;
            inset-inline-start: 100% !important;
        }

        .owl-nav { display: none; }
        .owl-carousel,
        .owl-carousel .owl-item { position: initial; }
    </style>

    {% block head %}{% endblock %}
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/jquery.min.js' }}"></script>
    <script>
        Number.prototype.toLocaleFixed = function(currency = '') {
            return currency.concat(' ').concat(
                this.toLocaleString(undefined, {
                    minimumFractionDigits: 2
                })).trim();
        };
        String.prototype.cleanPhone = function() {
            return this.replace(/[^0-9\+]+/g, '');
        };
    </script>
</head>
<body class="site-body {{ lang == 'ar' ? 'rtl' : 'ltr' }}">
    <div class="app" id="app">

        {% set ad = getFunction('getad') %}
        {% set path = getFunction('getPath') %}
        {% set id = product is defined ? product['id'] : 0 %}
        {% if ad %}
            {% set link = jsonDecode(ad['link']) %}

            {% if ad['pages'] == 'all' or
                (ad['pages'] == 'home' and path == '/') or
                (ad['pages'] == 'category' and path != '/' and id == 0) or
                (ad['pages'] == 'product' and id > 0) or
                (ad['pages'] == 'cart' and path == 'checkout/cart') or
                (ad['pages'] == 'checkout' and path == 'checkout/onepage') %}

                <div class="store-notify" style="background-color: {{ ad['background_color'] }}; color: {{ ad['font_color'] }};">
                    <div class="container center-between py-2.5">
                        <h2 class="flex-1 font-bold text-center text-sm">
                            <i class="inline-block align-middle mr-2 text-base {{ ad['icon'] }}" style="background-color: {{ ad['background_color'] }}; color: {{ ad['font_color'] }};"></i>
                            {% if link['slug'] %}
                                <a class="text-white" href="/{{ link['slug'] }}" target="_self">
                            {% else %}
                                <a class="text-white" target="_self">
                            {% endif %}
                                {{ ad['description'] }}
                            </a>
                        </h2>
                        <a href="#" class="px-1 ad-close icon-cancel" id="notify-close" aria-label="close-alert"></a>
                    </div>
                </div>

            {% endif %}
        {% endif %}

        <div class="site-shell-header">
            {{ include("layout/header.twig") }}
        </div>
        
        <main class="site-shell-main site-main">
            <div class="site-shell-content">
                {% block main_content %}{% endblock %}
            </div>
        </main>
        <div class="site-shell-footer">
            {{ include("layout/footer.twig") }}
        </div>

        {% if not authUser %}
            {{ include("customers/session/popup.twig") }}
        {% endif %}
    </div>

    <script type="text/javascript">
        window.flashMessages = [];    
        window.serverErrors = [];
    </script>
    
    
    <script type="text/javascript" src="{{ asset_url ~'js/shop.js' }}"></script>
    <script type="text/javascript" src="https://tawasa4shujat.twsaa.com/themes/uray/assets/js/plugins/owlcarousel/owl.carousel.min.js"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/swiper-bundle.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/bootstrap.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/toastr.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/plugins/font-awesome/font-awesome.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/jquery-ui.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/datepicker.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/ui.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/core/libraries/bootstrap-select.min.js' }}"></script>
    <script type="text/javascript" src="{{ asset_url ~'js/plugins/popper/popper.min.js' }}"></script>
    <script>
        {% set getSuccess = getFunction('getSuccess') %}
        {% if getSuccess %}
            toastr.options = {
                "closeButton" : true,
                "progressBar" : true
            };
            toastr.success("{{ getSuccess }}");
        {% endif %}
    
        {% set getError = getFunction('getError') %}
        {% if getError %}
            toastr.options = {
                "closeButton" : true,
                "progressBar" : true
            };
            toastr.error("{{ getError }}");
        {% endif %}

        {% set getInfo = getFunction('getInfo') %}
        {% if getInfo %}
            toastr.options = {
                "closeButton" : true,
                "progressBar" : true
            };
            toastr.info("{{ getInfo }}");
        {% endif %}
    
        {% set getWarning = getFunction('getWarning') %}
        {% if getWarning %}
            toastr.options = {
                "closeButton" : true,
                "progressBar" : true
            };
            toastr.warning("{{ getWarning }}");
        {% endif %}
    
        {% set getErrorMessage = getFunction('getErrorMessage') %}
        {% if getErrorMessage %}
            {% for error in getErrorMessage %}
                toastr.options = {
                    "closeButton" : true,
                    "progressBar" : true
                };
                toastr.error("{{ error }}");
            {% endfor %}
        {% endif %}
    </script>
    {# Search uses SubCove's /api/search integration below; do not initialize competing official search handlers. #}
    <script>
        $(document).ready(function() {
            var $search = $('.qs-search .ui.search');
            var $input = $search.find('.qs-search__input, .search-box');
            var $results = $search.find('.results');
            var $loader = $search.find('.search-loader');
            var $button = $search.find('.qs-search__button');
            var searchTimer = null;
            var activeRequest = null;

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : String(value)).html();
            }

            function normalizeProducts(response) {
                if (!response) return [];

                if (Array.isArray(response)) return response;
                if (Array.isArray(response.data)) return response.data;
                if (response.data && Array.isArray(response.data.data)) return response.data.data;
                if (Array.isArray(response.results)) return response.results;

                return [];
            }

            function closeSearchResults() {
                $results.removeClass('visible qs-search-open').hide().empty();
            }

            function productUrl(product) {
                if (product.url) return product.url;
                if (product.url_key) return '/' + String(product.url_key).replace(/^\/+/, '') + '?origsource=shopsearch';
                if (product.slug) return '/' + String(product.slug).replace(/^\/+/, '');
                return '#';
            }

            function renderResults(products, query) {
                if (!$results.length) return;

                if (!products.length) {
                    $results
                        .html('<div class="qs-search-empty">{{ lang == 'ar' ? 'لا توجد نتائج مطابقة' : 'No matching results' }}</div>')
                        .addClass('visible qs-search-open')
                        .show();
                    return;
                }

                var html = products.slice(0, 8).map(function(product) {
                    var name = escapeHtml(product.name || product.title || '');
                    var price = product.special_price || product.price || '';
                    var image = product.image || product.thumbnail || product.image_url || '';
                    var href = escapeHtml(productUrl(product));

                    return '<a class="result qs-search-result" href="' + href + '">' +
                        (image ? '<span class="qs-search-result__image"><img src="' + escapeHtml(image) + '" alt=""></span>' : '') +
                        '<span class="qs-search-result__body">' +
                            '<span class="qs-search-result__name">' + name + '</span>' +
                            (price ? '<span class="qs-search-result__price">' + escapeHtml(price) + '</span>' : '') +
                        '</span>' +
                    '</a>';
                }).join('');

                $results.html(html).addClass('visible qs-search-open').show();
            }

            function runSearch() {
                var query = $.trim($input.val() || '');

                if (query.length < 1) {
                    if (activeRequest && activeRequest.readyState !== 4) activeRequest.abort();
                    $loader.stop(true, true).hide();
                    closeSearchResults();
                    return;
                }

                if (activeRequest && activeRequest.readyState !== 4) activeRequest.abort();

                $loader.stop(true, true).fadeIn(120);

                activeRequest = $.ajax({
                    url: '/api/search',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        term: query,
                        language: false
                    }
                }).done(function(response) {
                    renderResults(normalizeProducts(response), query);
                }).fail(function(xhr, status) {
                    if (status !== 'abort') {
                        $results
                            .html('<div class="qs-search-empty">{{ lang == 'ar' ? 'تعذر البحث الآن، حاول مرة أخرى' : 'Search is temporarily unavailable' }}</div>')
                            .addClass('visible qs-search-open')
                            .show();
                    }
                }).always(function() {
                    $loader.stop(true, true).fadeOut(120);
                });
            }

            $input.off('.subcoveSearch').on('input.subcoveSearch', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(runSearch, 150);
            });

            $input.on('keydown.subcoveSearch', function(e) {
                if (e.key === 'Escape') {
                    closeSearchResults();
                    return;
                }

                if (e.key === 'Enter') {
                    e.preventDefault();
                    var firstHref = $results.find('a.qs-search-result').first().attr('href');
                    if (firstHref) {
                        window.location.href = firstHref;
                    } else {
                        runSearch();
                    }
                }
            });

            $button
                .attr('tabindex', '0')
                .css('cursor', 'pointer')
                .off('.subcoveSearch')
                .on('click.subcoveSearch', function() {
                    var firstHref = $results.find('a.qs-search-result').first().attr('href');
                    if (firstHref) {
                        window.location.href = firstHref;
                    } else {
                        runSearch();
                        $input.trigger('focus');
                    }
                });

            $(document).on('click.subcoveSearch', function(e) {
                if (!$(e.target).closest('.qs-search').length) {
                    closeSearchResults();
                }
            });
        });
    </script>
    {% block footer_scripts %}{% endblock %}

    <div class="qs-cart-toast" id="qs-global-cart-toast" role="status" aria-live="polite"></div>
    <div class="modal-overlay"></div>
    <script>
        (function () {
            var cartToastTimer = null;

            window.qsCartNotice = function (message, type) {
                var text = message || 'تم إضافة المنتج إلى السلة';
                var noticeType = type || 'success';

                if (window.toastr) {
                    toastr.options = {
                        closeButton: true,
                        progressBar: true,
                        timeOut: 2800,
                        positionClass: 'toast-top-left'
                    };

                    if (noticeType === 'error') {
                        toastr.error(text);
                    } else if (noticeType === 'warning') {
                        toastr.warning(text);
                    } else {
                        toastr.success(text);
                    }
                    return;
                }

                var toast = document.getElementById('qs-global-cart-toast');
                if (!toast) return;

                toast.textContent = text;
                toast.classList.toggle('is-error', noticeType === 'error');
                toast.classList.add('is-visible');

                clearTimeout(cartToastTimer);
                cartToastTimer = setTimeout(function () {
                    toast.classList.remove('is-visible');
                }, 2800);
            };

            function updateCartCount(count) {
                if (count === undefined || count === null || count === '') return;
                $('.cart-count')
                    .removeClass('d-none')
                    .text(count);
                $('.disabled-link').removeClass('disabled-link');
            }

            $(document).ready(function() {
                $(document).on('click', '.addToCart', function(e){
                    e.preventDefault();

                    var $button = $(this);
                    var productId = $button.data("id");
                    var formData = $('#addToCart-'+productId).serialize();
                    var imgtodrag = $button.closest('.product-card').find("img").eq(0);
                    var cart = $('.top-links-cart');

                    $button.prop('disabled', true);

                    $.ajax({
                        url: "{{ route('cart.addition', '') }}"+'/'+productId,
                        type: 'POST',
                        data: formData,
                        success: function (response) {
                            response = response || {};

                            if (response.success == true) {
                                window.qsCartNotice(response.message || 'تم إضافة المنتج إلى السلة', 'success');
                                updateCartCount(response.count !== undefined ? response.count : response.cart_count);

                                if (imgtodrag && imgtodrag.length && cart.length) {
                                    var imgclone = imgtodrag.clone()
                                        .offset({
                                            top: imgtodrag.offset().top,
                                            left: imgtodrag.offset().left
                                        })
                                        .css({
                                            'opacity': '0.5',
                                            'position': 'absolute',
                                            'height': '150px',
                                            'width': '150px',
                                            'z-index': '100'
                                        })
                                        .appendTo($('body'))
                                        .animate({
                                            'top': cart.offset().top + 10,
                                            'left': cart.offset().left + 10,
                                            'width': 75,
                                            'height': 75
                                        }, 700, 'easeInOutExpo');

                                    imgclone.animate({
                                        'width': 0,
                                        'height': 0
                                    }, function() {
                                        $(this).detach();
                                    });
                                }
                                return;
                            }

                            if (response['redirect-url']) {
                                // Redirects (e.g. configurable options or checkout) are part of the official response contract.
                                window.location.href = response['redirect-url'];
                                return;
                            }

                            window.qsCartNotice(response.message || 'تعذر إضافة المنتج إلى السلة', 'warning');
                        },
                        error: function (xhr) {
                            var message = 'تعذر إضافة المنتج إلى السلة';

                            if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }

                            window.qsCartNotice(message, 'error');
                        },
                        complete: function () {
                            $button.prop('disabled', false);
                        }
                    });
                });
            });
        })();
    </script>
    

<script>
document.addEventListener('error', function (event) {
    var el = event.target;
    if (!el || el.tagName !== 'IMG') return;

    var src = el.getAttribute('src') || '';
    var fallback = "{{ asset_url ~ 'images/placeholder.svg' }}";
    if (src === fallback) return;

    el.onerror = null;
    el.src = fallback;
}, true);
</script>

</body>
</html>
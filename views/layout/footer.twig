{% set channel = getFunction('getCurrentChannel') %}
{% set companyTax = getFunction('getCompanyTax') %}
{% set company = channel['getCompanyAddress'] %}

<footer class="qs-footer">
    <div class="qs-container">
        <div class="qs-footer__grid">
            <div class="qs-footer__about">
                {% if channel.logo %}
                    <img class="qs-footer__logo" src="{{ storage_url ~ channel.logo }}" alt="{{ channel.name|default('Store') }}">
                {% else %}
                    <strong class="qs-footer__logo-text">{{ channel.name|default('Store') }}</strong>
                {% endif %}
                <h3>{{ lang == 'ar' ? 'من نحن' : 'About us' }}</h3>
                <p>{{ channel.name }}</p>
                <div class="qs-footer__social">
                    {% if company.instagram %}<a href="https://www.instagram.com/{{ company.instagram }}" target="_blank" aria-label="Instagram"><i class="icon-instagram"></i></a>{% endif %}
                    {% if company.twitter %}<a href="https://twitter.com/{{ company.twitter }}" target="_blank" aria-label="Twitter"><i class="icon-twitter"></i></a>{% endif %}
                    {% if company.snapchat %}<a href="https://www.snapchat.com/add/{{ company.snapchat }}" target="_blank" aria-label="Snapchat"><i class="icon-snapchat"></i></a>{% endif %}
                    {% if company.youtube %}<a href="{{ company.youtube }}" target="_blank" aria-label="YouTube"><i class="icon-youtube"></i></a>{% endif %}
                </div>
            </div>

            <div class="qs-footer__column">
                <h3>{{ lang == 'ar' ? 'روابط تهمك' : 'Useful links' }}</h3>
                <ul>
                    {% if channel.getBlogs|length > 0 %}
                        <li><a href="/blogs/{{ company.company_id }}">{{ ('admin::app.admin.blog.blogs'|trans) }}</a></li>
                    {% endif %}
                    {% for page in channel.getCmsPages %}
                        {% if page.status == 1 %}
                            <li><a href="/page/{{ (page.url_key ?? page.translate('ar').url_key) }}">{{ page.page_title ?? page.translate('ar').page_title }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>

            <div class="qs-footer__column">
                <h3>{{ lang == 'ar' ? 'تواصل معنا' : 'Contact us' }}</h3>
                <div class="qs-footer__contact">
                    {% if company.whatsapp %}
                        <a href="https://wa.me/{{ company.whatsapp|replace({'~[^+0-9]~': ''}) }}" target="_blank"><i class="icon-whatsapp2"></i><span>{{ ('admin::app.customers.customers.whatsapp'|trans) }}</span></a>
                    {% endif %}
                    {% if company.phone_visibility == 0 %}
                        <a href="tel:{{ company.phone ?? '' }}"><i class="icon-phone"></i><span>{{ company.phone ?? ('admin::app.customers.customers.phone'|trans) }}</span></a>
                    {% endif %}
                    {% if company.email %}
                        <a href="mailto:{{ company.email ?? '' }}"><i class="icon-mail"></i><span>{{ company.email }}</span></a>
                    {% endif %}
                </div>
            </div>

            <div class="qs-footer__column">
                <h3>{{ lang == 'ar' ? 'الدفع الآمن' : 'Secure payment' }}</h3>
                <div class="qs-payment">
                    {% set defaultPayment = getFunction('getDefaultPaymentMethod') %}
                    {% set codPayment = getFunction('getInstallmentPaymentMethod') %}
                    {% set tabbyPayment = getFunction('getTabbyPaymentMethod') %}
                    {% set tamaraPayment = getFunction('getTamaraPaymentMethod') %}
                    {% set country = getSuperConfig('store.current_country_code') %}
                    {% if defaultPayment.getAdminPaymentMethod and defaultPayment.getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/visa.png" alt="Visa">
                        <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mastercard.png" alt="Mastercard">
                        {% if country != 'OM' %}
                            <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mada.png" alt="Mada">
                            <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/applepay.png" alt="Apple Pay">
                        {% endif %}
                    {% endif %}
                    {% if codPayment.getAdminPaymentMethod and codPayment.getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/cod.png" alt="Cash on delivery">
                    {% endif %}
                    {% if tabbyPayment and tabbyPayment.active|default(0) == 1 and tabbyPayment.getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tabby.webp" alt="Tabby">
                    {% endif %}
                    {% if tamaraPayment and tamaraPayment.active|default(0) == 1 and tamaraPayment.getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img class="qs-payment__method" src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tamara.svg" alt="Tamara">
                    {% endif %}
                </div>
                {% if company.certificate_id %}
                    {% if getSuperConfig('store.current_country_code') == 'OM' %}
                        <a class="qs-footer__certificate" href="https://maroof.om/businesses?keyword={{ company.certificate_id }}" target="_blank" rel="noopener noreferrer">
                            <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/sbc.webp" alt="{{ lang == 'ar' ? 'شهادة المتجر' : 'Store certificate' }}" loading="lazy">
                        </a>
                    {% else %}
                        <a class="qs-footer__certificate" href="https://eauthenticate.saudibusiness.gov.sa/certificate-details/{{ company.certificate_id }}" target="_blank" rel="noopener noreferrer">
                            <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/sbc.webp" alt="{{ lang == 'ar' ? 'شهادة المتجر' : 'Store certificate' }}" loading="lazy">
                        </a>
                    {% endif %}
                {% endif %}
                {% if companyTax and (companyTax.show_tax_no|default(0)) == 1 %}
                    <p class="qs-tax">{{ ('admin::app.footer.tax_no'|trans) }}: <strong>{{ companyTax.tax_no ?? '' }}</strong></p>
                {% endif %}
            </div>
        </div>

        <div class="qs-footer__bottom">
            {% if getConfig('config.general.show-platform-message') == 0 %}
                <p>© {{ "now"|date("Y") }} {{ lang == 'ar' ? 'حقوق الطبع والنشر' : 'All rights reserved' }} · {{ channel.name }}</p>
            {% else %}
                <p>{{ ('admin::app.footer.twsaa-reserved'|trans) }} {{ "now"|date("Y") }} | {{ ('admin::app.users.sessions.company'|trans) }}</p>
            {% endif %}
        </div>
    </div>
</footer>

<nav class="qs-mobile-bar" aria-label="{{ lang == 'ar' ? 'التنقل السريع' : 'Quick navigation' }}">
    <a href="/"><i class="icon-home"></i><span>{{ lang == 'ar' ? 'الرئيسية' : 'Home' }}</span></a>
    <a href="/checkout/cart" class="qs-mobile-bar__cart"><i class="icon-cart"></i><span>{{ lang == 'ar' ? 'سلة المشتريات' : 'Cart' }}</span><b class="cart-count count">{{ getFunction('cartItemsCount') }}</b></a>
    {% if company.whatsapp %}
        <a href="https://wa.me/{{ company.whatsapp|replace({'~[^+0-9]~': ''}) }}" target="_blank"><i class="icon-whatsapp2"></i><span>{{ lang == 'ar' ? 'الدعم الفني' : 'Support' }}</span></a>
    {% else %}
        <a href="/page/contact-us"><i class="icon-phone"></i><span>{{ lang == 'ar' ? 'الدعم الفني' : 'Support' }}</span></a>
    {% endif %}
</nav>
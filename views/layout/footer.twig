{% set channel = getFunction('getCurrentChannel') %}
{% set companyTax = getFunction('getCompanyTax') %}
{% set company = channel['getCompanyAddress'] %}

<footer class="site-footer">
    <div class="site-container">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                {% if channel and channel.logo %}
                    <a href="/" class="site-footer__logo-link">
                        <img src="{{ storage_url ~ channel.logo }}" alt="{{ channel.name|default('Store') }}" class="site-footer__logo">
                    </a>
                {% else %}
                    <a href="/" class="site-footer__brand-name">{{ channel.name }}</a>
                {% endif %}
                <p class="site-footer__brand-copy">{{ channel.name }}</p>

                <ul class="site-footer__social">
                    {% if company.instagram %}<li><a href="https://www.instagram.com/{{ company.instagram }}" target="_blank" aria-label="Instagram"><i class="icon-instagram"></i></a></li>{% endif %}
                    {% if company.twitter %}<li><a href="https://twitter.com/{{ company.twitter }}" target="_blank" aria-label="Twitter"><i class="icon-twitter"></i></a></li>{% endif %}
                    {% if company.snapchat %}<li><a href="https://www.snapchat.com/add/{{ company.snapchat }}" target="_blank" aria-label="Snapchat"><i class="icon-snapchat"></i></a></li>{% endif %}
                    {% if company.tiktok %}<li><a href="https://www.tiktok.com/{{ company.tiktok }}/" target="_blank" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a></li>{% endif %}
                    {% if company.youtube %}<li><a href="{{ company.youtube }}" target="_blank" aria-label="YouTube"><i class="icon-youtube"></i></a></li>{% endif %}
                </ul>
            </div>

            <div class="site-footer__column">
                <h2 class="site-footer__title">{{ ('admin::app.front.support_team'|trans) }}</h2>
                <div class="site-footer__contact">
                    {% if company.whatsapp %}
                        <a href="https://wa.me/{{ company.whatsapp|replace({'~[^+0-9]~': ''}) }}" rel="nofollow" target="_blank"><i class="icon-whatsapp2"></i><span>{{ ('admin::app.customers.customers.whatsapp'|trans) }}</span></a>
                    {% endif %}
                    {% if company.phone_visibility == 0 %}
                        <a href="tel:{{ company.phone ?? '' }}"><i class="icon-phone"></i><span>{{ ('admin::app.customers.customers.phone'|trans) }}</span></a>
                    {% endif %}
                    {% if company.email %}
                        <a href="mailto:{{ company.email ?? '' }}"><i class="icon-mail"></i><span>{{ ('admin::app.customers.customers.email'|trans) }}</span></a>
                    {% endif %}
                </div>
            </div>

            {% if channel.getCmsPages|length > 0 or channel.getBlogs|length > 0 %}
            <div class="site-footer__column">
                <h2 class="site-footer__title">{{ ('admin::app.admin.store_data.other_links'|trans) }}</h2>
                <ul class="site-footer__links">
                    {% if channel.getBlogs|length > 0 %}
                        <li><a href="/blogs/{{ company.company_id }}">{{ ('admin::app.admin.blog.blogs'|trans) }}</a></li>
                    {% endif %}
                    {% for page in channel.getCmsPages %}
                        {% if page.status == 1 %}
                            <li><a href="/page/{{ (page.url_key ?? page.translate('ar').url_key) }}">{{ page.page_title ?? page.translate('ar').page_title }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div class="site-footer__column site-footer__payments-column">
                <h2 class="site-footer__title">{{ lang == 'ar' ? 'الدفع الآمن' : 'Secure payment' }}</h2>
                <div class="site-footer__payments">
                    {% if getFunction('getDefaultPaymentMethod').getAdminPaymentMethod and getFunction('getDefaultPaymentMethod').getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/visa.png" alt="Visa">
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mastercard.png" alt="Mastercard">
                        {% if getSuperConfig('store.current_country_code') != "OM" %}
                            <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mada.png" alt="Mada">
                            <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/applepay.png" alt="Apple Pay">
                        {% endif %}
                    {% endif %}
                    {% if (getFunction('getTabbyPaymentMethod') and getFunction('getTabbyPaymentMethod').active|default(0)) == 1 and (getFunction('getTabbyPaymentMethod').getAdminPaymentMethod['active']|default(0)) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tabby.webp" alt="Tabby">
                    {% endif %}
                    {% if (getFunction('getTamaraPaymentMethod') and getFunction('getTamaraPaymentMethod').active|default(0)) == 1 and (getFunction('getTamaraPaymentMethod').getAdminPaymentMethod['active']|default(0)) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tamara.svg" alt="Tamara">
                    {% endif %}
                </div>
                {% if companyTax and (companyTax.show_tax_no|default(0)) == 1 %}
                    <p class="site-footer__tax">{{ ('admin::app.footer.tax_no'|trans) }}: <strong>{{ companyTax.tax_no ?? '' }}</strong></p>
                {% endif %}
            </div>
        </div>

        <div class="site-footer__bottom">
            {% if getConfig('config.general.show-platform-message') == 0 %}
                <p>{{ ('admin::app.footer.right-reserved'|trans) }} {{ "now"|date("Y") }} · {{ channel.name }}</p>
            {% else %}
                <p>{{ ('admin::app.footer.twsaa-reserved'|trans) }} {{ "now"|date("Y") }} · {{ ('admin::app.users.sessions.company'|trans) }}</p>
            {% endif %}

            {% if company.certificate_id %}
                {% if getSuperConfig('store.current_country_code') == "OM" %}
                    <a class="site-footer__certificate" target="_blank" href="https://maroof.om/businesses?keyword={{ company.certificate_id }}">
                {% else %}
                    <a class="site-footer__certificate" target="_blank" href="https://eauthenticate.saudibusiness.gov.sa/certificate-details/{{ company.certificate_id }}">
                {% endif %}
                    <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/sbc.webp" alt="Business certificate" loading="lazy">
                </a>
            {% endif %}
        </div>
    </div>
</footer>
{# Keep the native Twsaa category links; expose optional category art for Vaultfy cards. #}
{% for index, category in categories %}
    <li parent="{{ index }}">
        <a href="/{{ category['slug'] }}" data-vf-image="{{ category['image_url']|default('')|e('html_attr') }}">
            {{ category['name'] }}
        </a>
        {% if category['children']|default([])|length > 0 %}
            {% include 'category/child.twig' with {'categories': category['children']} %}
        {% endif %}
    </li>
{% endfor %}
